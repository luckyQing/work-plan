<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.luckyqing.mapper.TaskMapper">

    <resultMap id="taskWithDetailMap" type="io.github.luckyqing.entity.dataobject.TaskDO">
        <id column="id" property="id"/>
        <result column="task_name" property="taskName"/>
        <result column="task_type" property="taskType"/>
        <result column="demand_id" property="demandId"/>
        <result column="assignee_id" property="assigneeId"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="total_hours" property="totalHours"/>
        <result column="status" property="status"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="assignee_name" property="assigneeName"/>
        <result column="demand_name" property="demandName"/>
    </resultMap>

    <select id="selectByAssigneeAndDateRange" resultMap="taskWithDetailMap">
        SELECT t.*, u.real_name AS assignee_name, d.demand_name
        FROM t_task t
        LEFT JOIN t_user u ON t.assignee_id = u.id
        LEFT JOIN t_demand d ON t.demand_id = d.id
        WHERE t.deleted = 0 AND t.assignee_id = #{assigneeId}
          AND t.start_date &lt;= #{endDate} AND t.end_date &gt;= #{startDate}
        ORDER BY t.start_date
    </select>

    <select id="selectByDateRange" resultMap="taskWithDetailMap">
        SELECT t.*, u.real_name AS assignee_name, d.demand_name
        FROM t_task t
        LEFT JOIN t_user u ON t.assignee_id = u.id
        LEFT JOIN t_demand d ON t.demand_id = d.id
        WHERE t.deleted = 0
          AND t.start_date &lt;= #{endDate} AND t.end_date &gt;= #{startDate}
        ORDER BY t.assignee_id, t.start_date
    </select>

</mapper>
