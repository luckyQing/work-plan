<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.luckyqing.mapper.DemandMapper">

    <resultMap id="demandWithDetailMap" type="io.github.luckyqing.entity.dataobject.DemandDO">
        <id column="id" property="id"/>
        <result column="demand_name" property="demandName"/>
        <result column="demand_type" property="demandType"/>
        <result column="project_id" property="projectId"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="priority" property="priority"/>
        <result column="creator_id" property="creatorId"/>
        <result column="start_date" property="startDate"/>
        <result column="end_date" property="endDate"/>
        <result column="total_hours" property="totalHours"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="project_name" property="projectName"/>
        <result column="creator_name" property="creatorName"/>
    </resultMap>

    <select id="selectAllWithDetail" resultMap="demandWithDetailMap">
        SELECT d.*, p.project_name, u.real_name AS creator_name
        FROM t_demand d
        LEFT JOIN t_project p ON d.project_id = p.id
        LEFT JOIN t_user u ON d.creator_id = u.id
        WHERE d.deleted = 0
        ORDER BY d.create_time DESC
    </select>

</mapper>
