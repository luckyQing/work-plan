<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.luckyqing.mapper.SysUserMapper">

    <!-- 通用结果映射：用户信息 + 部门名称 -->
    <resultMap id="userWithDeptMap" type="io.github.luckyqing.entity.SysUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="dept_id" property="deptId"/>
        <result column="role" property="role"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="dept_name" property="deptName"/>
    </resultMap>

    <!-- 查询所有用户（关联部门名称） -->
    <select id="selectAllWithDept" resultMap="userWithDeptMap">
        SELECT u.*, d.dept_name
        FROM sys_user u
        LEFT JOIN sys_dept d ON u.dept_id = d.id
        WHERE u.deleted = 0
        ORDER BY u.id
    </select>

    <!-- 根据ID查询用户（关联部门名称） -->
    <select id="selectByIdWithDept" resultMap="userWithDeptMap" parameterType="long">
        SELECT u.*, d.dept_name
        FROM sys_user u
        LEFT JOIN sys_dept d ON u.dept_id = d.id
        WHERE u.id = #{id}
          AND u.deleted = 0
    </select>

</mapper>
